    "add_cutter_table_footer" : {
      "comment" : "A description of the CSV file format.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The csv file needs to follow the format \"<name>\",\"<number>\" for example:\"Zac\",\"15\". If the file has headers please set ON the option above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo CSV debe seguir el formato \"<nombre>\",\"<número>\", por ejemplo: \"Zac\",\"15\". Si el archivo tiene encabezados, active la opción anterior."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo CSV debe seguir el formato \"<nombre>\",\"<número>\", por ejemplo: \"Zac\",\"15\". Si el archivo tiene encabezados, active la opción anterior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo CSV precisa seguir o formato \"<nome>\",\"<número>\", por exemplo: \"Zac\",\"15\". Se o arquivo tiver cabeçalhos, ative a opção acima."
          }
        }
      }
    },
